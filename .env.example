# Copy this file to .env and fill it in:  cp .env.example .env
# The .env file is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# MongoDB connection string (users + chat history).
#   docker compose: leave empty to use the bundled mongo service
#   hosted:         a MongoDB Atlas URI, e.g. mongodb+srv://user:pass@cluster.mongodb.net/reposage
MONGO_URI=

# JWT signing key. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated origins allowed by CORS. Only needed when the frontend is served
# from a different origin than the API (e.g. Vite dev server or a Vercel frontend).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# LLM provider. Default is Groq (free tier, fast).
# Switch providers by changing LLM_PROVIDER — no code changes needed.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# --- groq (FREE, fast) --- get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- gemini (FREE) --- get a key at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# --- openrouter (FREE :free models) --- get a key at https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# --- anthropic (PAID, highest quality) --- key at https://console.anthropic.com
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides (defaults live in config.py / LLM_PRESETS)
# ---------------------------------------------------------------------------
# LLM_MODEL=llama-3.3-70b-versatile   # override the model for the chosen provider
# LLM_BASE_URL=                       # override the endpoint entirely
# LLM_API_KEY=                        # generic key, used with LLM_BASE_URL
# EMBED_MODEL=BAAI/bge-m3             # Docker image defaults to sentence-transformers/all-MiniLM-L6-v2
# RETRIEVER=dense                     # dense | hybrid
# RERANK=0                            # 1 = cross-encoder reranker (extra ~90 MB model, more RAM)
# TOP_K=8

# docker compose only: host port to publish the app on
# APP_PORT=8000
